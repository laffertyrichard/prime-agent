{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "arm",
    "sourceSha",
    "preregistrationSha",
    "corpusVersion",
    "blindCorpusSha256",
    "goldPairsSha256",
    "invocations",
    "outputsMutuallyHiddenUntilFrozen"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "arm": {
      "type": "string",
      "enum": [
        "RUN_A_CONTROL",
        "RUN_B_OPUS5"
      ]
    },
    "sourceSha": {
      "type": "string",
      "enum": [
        "bd247656aeeabea6b347bc892c0bfb9236fd7663"
      ]
    },
    "preregistrationSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "corpusVersion": {
      "type": "string",
      "enum": [
        "frozen-1"
      ]
    },
    "blindCorpusSha256": {
      "type": "string",
      "enum": [
        "b7b3f5cab0bc588d0a33f560275ff599fcef484287f07c078bc4b763b8043e9b"
      ]
    },
    "goldPairsSha256": {
      "type": "string",
      "enum": [
        "5842ff5334d326252c0d9f7d4f0906ad5f1086333415c60ddf481fc18262695b"
      ]
    },
    "outputsMutuallyHiddenUntilFrozen": {
      "type": "boolean",
      "enum": [
        true
      ]
    },
    "invocations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "condition",
          "reviewer",
          "tool",
          "toolVersion",
          "requestedModel",
          "exitCode",
          "promptSha256",
          "responseSchemaSha256",
          "modelUsage",
          "rawArtifact",
          "rawArtifactSha256"
        ],
        "properties": {
          "condition": {
            "type": "string",
            "enum": [
              "A",
              "B"
            ]
          },
          "reviewer": {
            "type": "string",
            "enum": [
              "codex",
              "claude"
            ]
          },
          "tool": {
            "type": "string",
            "enum": [
              "codex-cli",
              "Claude Code"
            ]
          },
          "toolVersion": {
            "type": "string",
            "minLength": 1
          },
          "requestedModel": {
            "type": "string",
            "minLength": 1
          },
          "exitCode": {
            "type": "integer"
          },
          "promptSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "responseSchemaSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sessionId": {
            "type": "string",
            "minLength": 1
          },
          "modelUsage": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "model",
                "canonicalModel",
                "provider",
                "inputTokens",
                "outputTokens"
              ],
              "properties": {
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "canonicalModel": {
                  "type": "string",
                  "minLength": 1
                },
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "inputTokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "outputTokens": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "rawArtifact": {
            "type": "string",
            "minLength": 1
          },
          "rawArtifactSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "eventsArtifact": {
            "type": "string",
            "minLength": 1
          },
          "eventsArtifactSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
