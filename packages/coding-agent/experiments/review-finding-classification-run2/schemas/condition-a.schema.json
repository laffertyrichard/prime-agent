{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "condition",
    "classifications"
  ],
  "properties": {
    "condition": {
      "type": "string",
      "enum": [
        "A"
      ]
    },
    "classifications": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "findingId",
          "rootClass",
          "conciseRationale"
        ],
        "properties": {
          "findingId": {
            "type": "string",
            "pattern": "^F[0-9]{2}$"
          },
          "rootClass": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "conciseRationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}
