{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "auditVersion",
    "blindCorpusSha256",
    "items",
    "corpusPass",
    "corpusConcerns"
  ],
  "properties": {
    "auditVersion": {
      "type": "string",
      "enum": [
        "corpus-validity-audit-v1"
      ]
    },
    "blindCorpusSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "items": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "itemId",
          "atomicity",
          "leakage",
          "duplicateManifestation",
          "duplicateItemIds",
          "conciseRationale"
        ],
        "properties": {
          "itemId": {
            "type": "string",
            "pattern": "^item-[0-9a-f]{12}$"
          },
          "atomicity": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "leakage": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "duplicateManifestation": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "duplicateItemIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^item-[0-9a-f]{12}$"
            }
          },
          "conciseRationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        }
      }
    },
    "corpusPass": {
      "type": "boolean"
    },
    "corpusConcerns": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 600
      }
    }
  }
}
